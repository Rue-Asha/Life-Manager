{
	"name": "life-manager",
	"private": true,
	"version": "0.11.0",
	"type": "module",
	"engines": {
		"node": ">=22.5"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run --reporter=verbose",
		"test:e2e": "playwright test --reporter=list",
		"proof": "node scripts/fingerprint/check-slop.mjs && node scripts/fingerprint/check-drift.mjs && npm run check && npm run build && npm run test:unit",
		"proof:full": "npm run proof && npm run test:e2e",
		"package": "npm run build && node scripts/package.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"marked": "^18.1.1"
	}
}
