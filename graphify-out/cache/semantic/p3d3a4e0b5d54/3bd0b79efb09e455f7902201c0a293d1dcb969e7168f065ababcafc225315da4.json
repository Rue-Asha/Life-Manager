{"nodes": [{"id": "design_style_tile", "label": "Life Manager style tile", "file_type": "document", "source_file": "design/style-tile.html", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static style tile: every colour, size and duration comes from tokens.css; shows the app frame hero plus a specimen of colour, aspects, icons, type and components."}, {"id": "design_style_tile_today_app_frame", "label": "Today view app frame (sidebar + grouped todo rows)", "file_type": "concept", "source_file": "design/style-tile.html", "source_location": "L355", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hero mock: sidebar with Today/Sprint/Backlog/Recurring and Aspects nav, Today page with quick add, Overdue group, aspect groups, priority bars and checkboxes; sidebar hides below 767px and a back link appears."}, {"id": "design_style_tile_forest_green_colour_scheme", "label": "Cream paper, stone surfaces, forest-green accent colour scheme", "file_type": "concept", "source_file": "design/style-tile.html", "source_location": "L439", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One forest green for the primary action and focus; matches palette C, suggesting C was adopted into tokens.css."}, {"id": "design_style_tile_overdue_red_rule", "label": "Red only when something is late", "file_type": "rationale", "source_file": "design/style-tile.html", "source_location": "L439", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overdue is the only use of red so lateness stands out; the --overdue token colours late counts, group heads and chips."}, {"id": "design_style_tile_aspect_colour_system", "label": "Aspect colour system (8 fixed colours with tints)", "file_type": "concept", "source_file": "design/style-tile.html", "source_location": "L35", "source_url": null, "captured_at": null, "au