{"nodes": [{"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_doc", "label": "Calendar Planning Design", "file_type": "document", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_loosened_day_invariant", "label": "Loosened todo day invariant", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From \"a todo has a day only while in a sprint\" to \"in a sprint iff its day lies in that sprint week; a backlog todo may carry a future day\"."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_migration_5", "label": "Migration 5 (start_time/end_time)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Additive, four nullable TEXT columns, no CHECK: a CHECK would be final (migration 4 note) and buys nothing over the server check in $lib/slot.ts (R4)."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_placement_rule", "label": "Placement rule in planning.ts", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setDay and createTodo both need \"where does a todo with this date live\"; own module with raw SQL avoids an import cycle since sprints.ts imports todos.ts."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_slot_follows_day", "label": "Slot follows day invariant", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No day implies no slot; every SQL path that nulls day also nulls start_time/end_time."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_setday_entry_point", "label": "setDay as single planning entry point", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "slot omitted keeps the current slot (DayPicker/drag); passed replaces it; plan validated before writing so a refused date leaves no half-saved todo."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_sprint_start_order", "label": "Sprint start order", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One transaction: suggested pull -> auto-pull planned-in-week -> missed pull as Unscheduled -> generateInstances; archived-semester todos skipped by todoWritable."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_projection_in_calendar", "label": "Recurring projection in calendar.ts", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projection only reads rules and is used only by the calendar; keeping it out of recurring.ts lets recurring and calendar units run in parallel; projected only after the active sprint week to avoid doubling real instances (R3)."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_calendar_month_grid", "label": "Read-only month calendar grid", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RailLayout wide mode with the selected day list as rail; below 768 px the list renders under the grid; exams use class colour."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_slot_module", "label": "$lib/slot.ts (validateSlot, slotLabel, plannedLabel)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_calendar_nav_entry", "label": "Calendar nav entry (eighth)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses existing calendar icon; NAV_ITEMS count becomes optional."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_release_v0_5_0", "label": "Release v0.5.0", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature -> minor; no release delta spec since release-artifact derives version from package.json."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_proton_calendar_sync_split", "label": "Proton Calendar sync (split off)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next change: sync via roman-16/proton-cli sidecar, one Proton calendar per aspect; ICS subscription rejected."}, {"id": "openspec_changes_archive_2026_10_18_calendar_planning_design_two_todo_read_models", "label": "Two todo read models (calendar)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "openspec_changes_archive_2026_10_18_calendar_planning_design_doc", "target": "openspec_changes_archive_2026_10_18_calendar_planning_design_loosened_day_invariant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_10_18_calendar_planning_design_doc", "target": "openspec_changes_archive_2026_10_18_calendar_planning_design_migration_5", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_10_18_calendar_planning_design_doc", "target": "openspec_changes_archive_2026_10_18_calendar_planning_design_placement_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_10_18_calendar_planning_design_doc", "target": "openspec_changes_archive_2026_10_18_calendar_planning_design_slot_follows_day", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-10-18-calendar-planning/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_10_18_calendar_plan