{"nodes": [{"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design", "label": "proton-calendar-sync design", "file_type": "document", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design_diff_reconciler", "label": "Diff reconciler (desired vs stored hashes)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes are spread over ~15 domain functions incl. bulk UPDATEs and FK cascades, so per-write hooks/outbox would miss changes; a diff pass from DB state catches everything."}, {"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design_migration_6_proton_tables", "label": "Migration 6: proton_calendars and proton_items", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design_desired_state_stored_fields_only", "label": "Desired state reads stored fields only", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses stored day/slot, never derived dueDay or due_date; shares projectionStart and archivedRuleIds with calendarMonth so app calendar and Proton cannot drift."}, {"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design_series_exdates_gate1_a", "label": "Series EXDATE exclusions (Gate 1 addition a)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "proton-cli has no EXDATE flag; occurrence deletes add EXDATEs and updates drop them, so the reconciler re-deletes excluded occurrences after each series push."}, {"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design_sync_worker", "label": "Sync worker (debounce 30 s, tick 5 min, backoff, relogin pause)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design_cli_runner", "label": "CLI runner (execFile, pacing, timeout, TZ=Europe/Berlin)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TZ is set because proton-cli v5.1.0 parses timed occurrence refs in local time; the adapter is the only place building argv or parsing output."}, {"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design_fake_proton_cli", "label": "Fake proton CLI (scripts/fake-proton.mjs)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain JS since CI Node 22 cannot run .ts; tests never talk to Proton."}, {"id": "openspec_changes_archive_2026_10_18_proton_calendar_sync_design_eventspec_type", "label": "EventSpec type (hash field order)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-18-proton-calendar-sync/design.md", "source_location": null, "source_url": null, "captured_at